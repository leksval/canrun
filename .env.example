# Developer Environment Configuration for CanRun Data Science Pipeline
# Copy this file to .env for offline dataset harvesting and model retraining.
# End-user runtime is 100% keyless and does not require .env.

# Optional: Steam Web API Key for developer game discovery and store-spec harvesting.
# It does not unlock Steam player FPS: GetGameFrameRateStats returns HTTP 401 to outside keys.
# Obtain from: https://steamcommunity.com/dev/apikey
STEAM_WEBAPI_KEY=

# Public benchmark API endpoint used by scripts/ds_pipeline/collect_and_audit.py
FPSHQ_API_URL=https://fpshq.com/api/public/v1
